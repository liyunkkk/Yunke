# macOS 本地文件
.DS_Store

# IntelliJ / Android Studio 生成的工程状态
*.iml
/.idea/

# Gradle / Kotlin 构建缓存
**/.gradle/
/.kotlin/
**/build/
# The build-logic Java package is source, not generated build output.
!buildSrc/src/main/java/eta/build/
!buildSrc/src/test/java/eta/build/

# Android 构建产物
.cxx/
.externalNativeBuild/
/app/release/
captures/
*.apk
*.aab
output-metadata.json
*.hprof

# 日志与本地凭据
*.log
*.jks
*.keystore
*.p12
keystore.properties
google-services.json

# 本地配置和临时分析产物
/local.properties
/.analysis/
/.tmp/

# 外部源码参考，仅供阅读，不参与当前仓库版本管理
/reference/

# 临时构建产物（勿提交）
.tmp-art/
# Runtime-owned collaboration workspaces and artifacts
/.agent/

# Python 字节码（本机跑 app/src/test/python 的契约测试会产生）
__pycache__/
*.pyc
# 例外：随 APK 打包的 agent 资源原本就带这份预编译模块，已跟踪，保留
!app/src/main/assets/agent/__pycache__/
!app/src/main/assets/agent/__pycache__/*.pyc
